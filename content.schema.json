{
  "title": "content.yaml",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "site": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "subtitle",
        "description"
      ]
    },
    "sidebar": {
      "type": "object",
      "properties": {
        "monogram": {
          "type": "string",
          "minLength": 1
        },
        "links": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "label",
                  "url"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "monogram"
      ]
    },
    "intro": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "email": {
      "type": "string",
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
    },
    "email_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "photos": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "type": "string",
                "minLength": 1
              },
              "caption": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "focus": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "file",
              "alt"
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "experience": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dates": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "company": {
                "type": "string",
                "minLength": 1
              },
              "company_url": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "stack": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "number"
                        }
                      ]
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "dates",
              "title",
              "company"
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "education": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dates": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "school": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "dates",
              "title",
              "school"
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "projects": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "year": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "stack": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "number"
                        }
                      ]
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "shipped",
                  "in progress",
                  "archived"
                ]
              },
              "live": {
                "type": "string",
                "minLength": 1
              },
              "live_label": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "source_label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "year",
              "title"
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "labels": {
      "type": "object",
      "properties": {
        "nav_about": {
          "type": "string",
          "minLength": 1
        },
        "nav_projects": {
          "type": "string",
          "minLength": 1
        },
        "experience_heading": {
          "type": "string",
          "minLength": 1
        },
        "education_heading": {
          "type": "string",
          "minLength": 1
        },
        "projects_heading": {
          "type": "string",
          "minLength": 1
        },
        "email_prefix": {
          "type": "string",
          "minLength": 1
        },
        "live_link": {
          "type": "string",
          "minLength": 1
        },
        "source_link": {
          "type": "string",
          "minLength": 1
        },
        "theme_dark": {
          "type": "string",
          "minLength": 1
        },
        "theme_light": {
          "type": "string",
          "minLength": 1
        },
        "not_found_title": {
          "type": "string",
          "minLength": 1
        },
        "not_found_link": {
          "type": "string",
          "minLength": 1
        },
        "skip_to_content": {
          "type": "string",
          "minLength": 1
        },
        "main_nav": {
          "type": "string",
          "minLength": 1
        },
        "collapse_sidebar": {
          "type": "string",
          "minLength": 1
        },
        "expand_sidebar": {
          "type": "string",
          "minLength": 1
        },
        "switch_to_dark": {
          "type": "string",
          "minLength": 1
        },
        "switch_to_light": {
          "type": "string",
          "minLength": 1
        },
        "photos": {
          "type": "string",
          "minLength": 1
        },
        "previous_photo": {
          "type": "string",
          "minLength": 1
        },
        "next_photo": {
          "type": "string",
          "minLength": 1
        },
        "photo_position": {
          "type": "string",
          "minLength": 1
        },
        "show_details": {
          "type": "string",
          "minLength": 1
        },
        "hide_details": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "nav_about",
        "nav_projects",
        "experience_heading",
        "education_heading",
        "projects_heading",
        "email_prefix",
        "live_link",
        "source_link",
        "theme_dark",
        "theme_light",
        "not_found_title",
        "not_found_link",
        "skip_to_content",
        "main_nav",
        "collapse_sidebar",
        "expand_sidebar",
        "switch_to_dark",
        "switch_to_light",
        "photos",
        "previous_photo",
        "next_photo",
        "photo_position",
        "show_details",
        "hide_details"
      ]
    },
    "cursor_trail": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "pixel_size": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64
        },
        "fade_ms": {
          "type": "integer",
          "minimum": 50,
          "maximum": 5000
        },
        "spacing": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_pixels": {
          "default": 60,
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "click_explosion": {
          "type": "boolean"
        },
        "explosion_pixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "colors_light": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{3,8}$"
          }
        },
        "colors_dark": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{3,8}$"
          }
        }
      },
      "required": [
        "enabled",
        "pixel_size",
        "fade_ms",
        "click_explosion",
        "explosion_pixels",
        "colors_light",
        "colors_dark"
      ]
    },
    "name_fonts": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hold_seconds": {
          "type": "number",
          "minimum": 0
        },
        "type_ms": {
          "type": "integer",
          "minimum": 10,
          "maximum": 9007199254740991
        },
        "delete_ms": {
          "type": "integer",
          "minimum": 10,
          "maximum": 9007199254740991
        },
        "cursor": {
          "type": "string",
          "enum": [
            "block",
            "bar"
          ]
        },
        "size": {
          "type": "number",
          "minimum": 16,
          "maximum": 200
        },
        "fonts": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "font": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "default": 400,
                "type": "integer",
                "minimum": 100,
                "maximum": 900
              },
              "italic": {
                "default": false,
                "type": "boolean"
              },
              "tracking": {
                "default": 0,
                "type": "number"
              }
            },
            "required": [
              "font"
            ]
          }
        }
      },
      "required": [
        "enabled",
        "hold_seconds",
        "type_ms",
        "delete_ms",
        "cursor",
        "size",
        "fonts"
      ]
    }
  },
  "required": [
    "site",
    "sidebar",
    "email",
    "labels",
    "cursor_trail",
    "name_fonts"
  ]
}
